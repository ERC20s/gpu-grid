# Settings the scheduler reads from the environment.
# Copy to .env for local work; on the group's server the values live in
# /etc/d8a/keys.env and reach the process through `d8a run -- <command>`.
# Names only are declared in the root .d8a keys: block — never values.

# How many seconds a host report stays valid. A host agent that does not
# re-report inside this window is evicted from the scheduler registry and
# stops winning matches. Default when unset: 120.
HOST_TTL_SECONDS=120

# How often the host agent posts to the scheduler, in seconds. Default: 30
# AGENT_REPORT_SECONDS=30

# Where to post host reports when the agent is enabled. Example: http://localhost:3000
# SCHEDULER_URL=http://localhost:3000
