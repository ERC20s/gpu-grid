# Settings the scheduler reads from the environment.
# Copy to .env for local work; on the group's server the values live in
# /etc/d8a/keys.env and reach the process through `d8a run -- <command>`.
# Names only are declared in the root .d8a keys: block — never values.

# How many seconds a host report stays valid. A host agent that does not
# re-report inside this window is evicted from the scheduler registry and
# stops winning matches. Default when unset: 120.
HOST_TTL_SECONDS=120

# Maximum accepted request body size in bytes for POST endpoints. Default: 262144 (256KB).
# Increase if you expect legitimately larger payloads, for example very large hosts arrays in /match.
# MAX_REQUEST_SIZE_BYTES=262144

# Maximum number of unique host ids the in-memory registry will accept. 0 = unlimited (default).
# Set to a positive integer to cap registry growth and reject new distinct hosts once reached.
# Hosts past HOST_TTL_SECONDS are evicted before the cap is checked, so dead hosts hold no slot.
# MAX_HOSTS=0

# Who may write. JSON objects of {"<id>": "<token>"}; tokens are at least 16
# non-space characters. Unset = every write that needs it gets 401.
# HOST_TOKENS - host id -> token, for POST /hosts and DELETE /hosts/:id.
# USER_TOKENS - user id -> token, for POST /match (no two users share one).
# HOST_TOKENS=
# USER_TOKENS=

# POST /match submissions allowed per user per window. Defaults: 60 per 60s,
# tracking at most 10000 users.
# SUBMIT_RATE_LIMIT=60
# SUBMIT_RATE_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_KEYS=10000

# Port the scheduler listens on (defaults to 3000; the .d8a run: block
# already pins the scheduler terminal to 3000).
# PORT=3000
